rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper para comprobar si el usuario es administrador
    function isAdmin() {
      return request.auth != null && 
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Reglas para logos corporativos subidos por usuarios
    match /brands/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Reglas para kits finales (.zip) subidos por el administrador
    match /deliverables/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
  }
}
