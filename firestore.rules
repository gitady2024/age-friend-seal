rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reglas para la colección 'empresas':
    // El ID del documento debe coincidir con el UID del usuario autenticado.
    match /empresas/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reglas para la colección 'diagnosticos':
    // Lectura y escritura permitidas únicamente para el usuario dueño del diagnóstico.
    // Al crear un diagnóstico, el campo 'id_empresa' debe coincidir con el UID del usuario.
    match /diagnosticos/{diagnosticoId} {
      allow create: if request.auth != null && request.resource.data.id_empresa == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.id_empresa == request.auth.uid;
    }

    // Reglas para la colección 'entregables_b2b':
    // Lectura permitida para el usuario dueño (si su UID coincide con 'id_empresa').
    // Escritura deshabilitada desde el SDK del cliente (solo permitida mediante backend/Cloud Functions).
    match /entregables_b2b/{entregableId} {
      allow read: if request.auth != null && resource.data.id_empresa == request.auth.uid;
      allow write: if false;
    }
  }
}
